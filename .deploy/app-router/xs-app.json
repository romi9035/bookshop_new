{
  "authenticationMethod": "route",
  "login": {
    "callbackEndpoint": "/login/callback"
  },
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "^/$",
      "target": "/admin/index.html",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/admin/(.*\\.(?:html|js|json|css|properties|xml|png|jpg|jpeg|svg|ico|woff|woff2|ttf))$",
      "target": "/admin/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/-/cds/.*",
      "destination": "mtx-api",
      "authenticationType": "none"
    },
    {
      "source": "^/(admin|browse|odata|rest|hcql)/",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ]
}